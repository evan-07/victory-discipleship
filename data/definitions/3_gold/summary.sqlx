config {
  type: "view",
  schema: dataform.projectConfig.vars.gold_dataset,
  description: "Summary stats of members (Gold Layer)",
  tags: ["gold"]
}

SELECT
  COUNT(*) as total_members,
  COUNTIF(gender = 'Male') as total_males,
  COUNTIF(gender = 'Female') as total_females,
  COUNTIF(mobile_number IS NOT NULL) as members_with_mobile
FROM
  ${ref("members")}
