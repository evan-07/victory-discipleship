config {
  type: "table",
  schema: dataform.projectConfig.vars.gold_dataset,
  description: "Dimension table for members with derived analytical columns.",
  dependencies: ["members"]
}

SELECT
  -- Identifiers & Contact
  email,
  first_name,
  last_name,
  mobile_number,
  
  -- Demographics
  gender,
  PARSE_DATE('%m/%d/%Y', birthday) AS birth_date,
  DATE_DIFF(CURRENT_DATE(), PARSE_DATE('%m/%d/%Y', birthday), YEAR) AS age,
  
  -- Life Stage Logic
  CASE
    WHEN DATE_DIFF(CURRENT_DATE(), PARSE_DATE('%m/%d/%Y', birthday), YEAR) < 20 THEN 'Youth'
    WHEN occupation_type = 'Student' THEN 'Student'
    WHEN marital_status = 'Single' AND occupation_type = 'Professional' THEN 'Single Professional'
    WHEN marital_status = 'Single' THEN 'Single' -- Catch-all for other singles
    WHEN marital_status = 'Married' THEN 'Married'
    ELSE marital_status
  END AS life_stage,
  
  marital_status,
  
  -- Location (Placeholder)
  'Unknown' AS campus,
  
  -- Ministry Stats
  ministry_teams,
  want_ministry,
  CASE
    WHEN ARRAY_LENGTH(ministry_teams) > 0 THEN 'Active'
    WHEN ARRAY_LENGTH(want_ministry) > 0 THEN 'Interested'
    ELSE 'None'
  END AS ministry_status,
  
  -- Leadership Stats
  is_vg_leader,
  is_vg_member,
  CASE
    WHEN is_vg_leader THEN 'Leader'
    WHEN is_vg_member THEN 'Member'
    ELSE 'Crowd'
  END AS leadership_status,
  
  -- Other Dimensions
  occupation_type,
  discipleship_classes
  
FROM
  ${ref("members")}
