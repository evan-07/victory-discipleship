config {
  type: "table",
  schema: dataform.projectConfig.vars.gold_dataset,
  description: "Simplified dimension table for Looker dashboards focused on demographics, VG leadership, and occupation.",
  bigquery: {
    partitionBy: "_PARTITIONDATE"
  },
  dependencies: ["stg_members"]
}

SELECT
  -- Identifiers & Contact
  email,
  first_name,
  last_name,
  mobile_number,
  
  -- Demographics
  gender,
  COALESCE(SAFE.PARSE_DATE('%Y-%m-%d', birthday), SAFE.PARSE_DATE('%m/%d/%Y', birthday)) AS birth_date,
  DATE_DIFF(CURRENT_DATE(), COALESCE(SAFE.PARSE_DATE('%Y-%m-%d', birthday), SAFE.PARSE_DATE('%m/%d/%Y', birthday)), YEAR) AS age,
  
  -- Age Group Logic (for Looker dashboards)
  CASE
    WHEN DATE_DIFF(CURRENT_DATE(), COALESCE(SAFE.PARSE_DATE('%Y-%m-%d', birthday), SAFE.PARSE_DATE('%m/%d/%Y', birthday)), YEAR) < 13 THEN 'Kids'
    WHEN DATE_DIFF(CURRENT_DATE(), COALESCE(SAFE.PARSE_DATE('%Y-%m-%d', birthday), SAFE.PARSE_DATE('%m/%d/%Y', birthday)), YEAR) BETWEEN 13 AND 17 THEN 'Youth'
    WHEN DATE_DIFF(CURRENT_DATE(), COALESCE(SAFE.PARSE_DATE('%Y-%m-%d', birthday), SAFE.PARSE_DATE('%m/%d/%Y', birthday)), YEAR) BETWEEN 18 AND 35 THEN 'Young Adult'
    WHEN DATE_DIFF(CURRENT_DATE(), COALESCE(SAFE.PARSE_DATE('%Y-%m-%d', birthday), SAFE.PARSE_DATE('%m/%d/%Y', birthday)), YEAR) BETWEEN 36 AND 59 THEN 'Adult'
    ELSE 'Senior'
  END AS age_group,
  
  marital_status,
  
  -- Occupation (for Students/Professionals/Business Owners breakdown)
  occupation_type,
  
  -- VG Leadership (for VG Leaders count & people led)
  is_vg_leader,
  vg_count,
  vg_leader_name
  
FROM
  ${ref("stg_members")}
WHERE
  birthday IS NOT NULL AND birthday != ''
