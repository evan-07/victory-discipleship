config {
  type: "table",
  schema: dataform.projectConfig.vars.gold_dataset,
  description: "Daily snapshots of key metrics for trend analysis in Looker.",
  tags: ["reporting", "gold"],
  dependencies: ["create_infrastructure"]
}

WITH daily_counts AS (
  SELECT
    DATE(ingestion_timestamp) AS report_date,
    COUNT(email) AS new_signups,
    COUNTIF(is_vg_member = TRUE) AS new_vg_members,
    COUNTIF(is_ministry_member = TRUE) AS new_ministry_members,
    COUNTIF(is_vg_leader = TRUE) AS new_leaders
  FROM
    ${ref("members")}
  GROUP BY
    1
)

SELECT
  report_date,
  new_signups,
  new_vg_members,
  new_ministry_members,
  new_leaders,
  -- Cumulative Sums for "Total to Date" charts
  SUM(new_signups) OVER (ORDER BY report_date) AS total_members_to_date,
  SUM(new_vg_members) OVER (ORDER BY report_date) AS total_vg_members_to_date,
  SUM(new_leaders) OVER (ORDER BY report_date) AS total_leaders_to_date
FROM
  daily_counts
ORDER BY
  report_date DESC
