config {
  type: "view",
  schema: dataform.projectConfig.vars.silver_dataset,
  description: "Growth metrics showing daily new member sign-ups.",
  tags: ["analytical"]
}

SELECT
  DATE(ingestion_timestamp) AS signup_date,
  COUNT(email) AS new_members_count
FROM
  ${ref("members")}
GROUP BY
  1
ORDER BY
  1 DESC
