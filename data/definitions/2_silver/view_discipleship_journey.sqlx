config {
  type: "view",
  schema: dataform.projectConfig.vars.silver_dataset,
  description: "Tracks the discipleship journey of members through various classes.",
  tags: ["analytical"]
}

SELECT
  email,
  first_name,
  last_name,
  discipleship_classes,
  -- Boolean flags for specific classes for easier filtering/counting
  REGEXP_CONTAINS(discipleship_classes, r'One2One') AS finished_one2one,
  REGEXP_CONTAINS(discipleship_classes, r'Victory Weekend') AS finished_victory_weekend,
  REGEXP_CONTAINS(discipleship_classes, r'Spiritual Foundations') AS finished_spiritual_foundations,
  REGEXP_CONTAINS(discipleship_classes, r'Discipleship Class') AS finished_discipleship_class,
  REGEXP_CONTAINS(discipleship_classes, r'Leadership L113') AS finished_leadership_113
FROM
  ${ref("members")}
