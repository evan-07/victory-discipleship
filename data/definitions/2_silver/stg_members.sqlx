config {
  type: "table",
  schema: dataform.projectConfig.vars.silver_dataset,
  description: "Cleaned member data with standardized phone numbers and deduplication.",
  assertions: {
    uniqueKey: ["email"],
    nonNull: ["email", "first_name", "last_name"]
  },
  bigquery: {
    partitionBy: "DATE(ingestion_timestamp)"
  }, 
  dependencies: ["create_infrastructure"]
}

WITH raw_data AS (
  SELECT
    ingestion_timestamp,
    JSON_EXTRACT_SCALAR(payload, '$.firstName') AS first_name,
    JSON_EXTRACT_SCALAR(payload, '$.middleName') AS middle_name,
    JSON_EXTRACT_SCALAR(payload, '$.lastName') AS last_name,
    JSON_EXTRACT_SCALAR(payload, '$.suffix') AS suffix,
    LOWER(TRIM(JSON_EXTRACT_SCALAR(payload, '$.email'))) AS email,
    JSON_EXTRACT_SCALAR(payload, '$.fbName') AS fb_name,
    JSON_EXTRACT_SCALAR(payload, '$.primaryMobile') AS raw_mobile,
    JSON_EXTRACT_SCALAR(payload, '$.secondaryMobile') AS raw_sec_mobile,
    JSON_EXTRACT_SCALAR(payload, '$.gender') AS gender,
    JSON_EXTRACT_SCALAR(payload, '$.birthday') AS birthday,
    JSON_EXTRACT_SCALAR(payload, '$.maritalStatus') AS marital_status,
    JSON_EXTRACT_SCALAR(payload, '$.anniversary') AS anniversary,
    
    -- Occupation
    JSON_EXTRACT_SCALAR(payload, '$.occupationType') AS occupation_type,
    JSON_EXTRACT_SCALAR(payload, '$.educationLevel') AS education_level,
    JSON_EXTRACT_SCALAR(payload, '$.school') AS school,
    JSON_EXTRACT_SCALAR(payload, '$.yearLevel') AS year_level,
    JSON_EXTRACT_SCALAR(payload, '$.course') AS course,
    JSON_EXTRACT_SCALAR(payload, '$.jobTitle') AS job_title,
    JSON_EXTRACT_SCALAR(payload, '$.company') AS company,
    JSON_EXTRACT_SCALAR(payload, '$.employerIndustry') AS employer_industry,
    JSON_EXTRACT_SCALAR(payload, '$.businessName') AS business_name,
    JSON_EXTRACT_SCALAR(payload, '$.businessNature') AS business_nature,
    JSON_EXTRACT_SCALAR(payload, '$.businessAddress') AS business_address,
    
    -- Spiritual Journey
    JSON_EXTRACT_SCALAR(payload, '$.discipleship') AS discipleship_classes,
    
    -- Ministry
    JSON_EXTRACT_SCALAR(payload, '$.isMinistryMember') = 'Yes' AS is_ministry_member,
    ARRAY(
      SELECT TRIM(m)
      FROM UNNEST(SPLIT(JSON_EXTRACT_SCALAR(payload, '$.ministry'), ',')) m
      WHERE TRIM(m) NOT IN ('', 'None', '0 rows')
    ) AS ministry_teams,
    ARRAY(
      SELECT TRIM(w)
      FROM UNNEST(SPLIT(JSON_EXTRACT_SCALAR(payload, '$.wantMinistry'), ',')) w
      WHERE TRIM(w) NOT IN ('', 'None', "None, I'll pray for it", "I'll pray for it")
    ) AS want_ministry,
    
    -- Victory Group Member
    JSON_EXTRACT_SCALAR(payload, '$.isMember') = 'Yes' AS is_vg_member,
    JSON_EXTRACT_SCALAR(payload, '$.leaderName') AS vg_leader_name,
    JSON_EXTRACT_SCALAR(payload, '$.wantVg') AS want_vg,
    
    -- Victory Group Leader
    JSON_EXTRACT_SCALAR(payload, '$.isLeader') = 'Yes' AS is_vg_leader,
    SAFE_CAST(JSON_EXTRACT_SCALAR(payload, '$.groupCount') AS INT64) AS vg_count,
    JSON_EXTRACT_SCALAR(payload, '$.vgDetails') AS vg_details,
    JSON_EXTRACT_SCALAR(payload, '$.hasIntern') = 'Yes' AS has_intern,
    JSON_EXTRACT_SCALAR(payload, '$.internNames') AS intern_names
  FROM
    ${ref("raw_members")}
),

cleaned_data AS (
  SELECT
    *,
    -- Standardize mobile to local format (09xxxxxxxxx). 
    REGEXP_REPLACE(
      REGEXP_REPLACE(raw_mobile, r'^\+63', '0'), 
      r'^63', '0'
    ) AS mobile_number,
    REGEXP_REPLACE(
      REGEXP_REPLACE(raw_sec_mobile, r'^\+63', '0'), 
      r'^63', '0'
    ) AS sec_mobile_number
  FROM
    raw_data
)

SELECT
  * EXCEPT(raw_mobile, raw_sec_mobile)
FROM
  cleaned_data
QUALIFY ROW_NUMBER() OVER(PARTITION BY email ORDER BY ingestion_timestamp DESC) = 1
