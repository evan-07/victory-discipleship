config {
  type: "view",
  schema: dataform.projectConfig.vars.silver_dataset,
  description: "Analysis of active ministry members and the volunteer pipeline (Want Ministry).",
  tags: ["analytical"]
}

SELECT
  email,
  first_name,
  last_name,
  is_ministry_member,
  ministry_teams,
  want_ministry,
  -- Categorize status
  CASE
    WHEN is_ministry_member THEN 'Active'
    WHEN ARRAY_LENGTH(want_ministry) > 0 THEN 'Interested'
    ELSE 'None'
  END AS ministry_status
FROM
  ${ref("members")}
WHERE
  is_ministry_member = TRUE 
  OR ARRAY_LENGTH(want_ministry) > 0
