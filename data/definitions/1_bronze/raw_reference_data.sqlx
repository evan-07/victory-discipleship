config {
  type: "table",
  schema: dataform.projectConfig.vars.bronze_dataset,
  description: "Reference data for form dropdowns and selections. Contains discipleship classes, ministry teams, and other configurable options."
}

CREATE OR REPLACE TABLE ${self()} AS
SELECT * FROM (
  -- Discipleship Classes
  SELECT 'discipleship_classes' AS category, 'One2One' AS value, 1 AS display_order, TRUE AS is_active, CURRENT_TIMESTAMP() AS created_at, CURRENT_TIMESTAMP() AS updated_at
  UNION ALL
  SELECT 'discipleship_classes', 'Victory Weekend', 2, TRUE, CURRENT_TIMESTAMP(), CURRENT_TIMESTAMP()
  UNION ALL
  SELECT 'discipleship_classes', 'Spiritual Foundations', 3, TRUE, CURRENT_TIMESTAMP(), CURRENT_TIMESTAMP()
  UNION ALL
  SELECT 'discipleship_classes', 'Discipleship Class / Leader''s Lab', 4, TRUE, CURRENT_TIMESTAMP(), CURRENT_TIMESTAMP()
  UNION ALL
  SELECT 'discipleship_classes', 'Leadership L113', 5, TRUE, CURRENT_TIMESTAMP(), CURRENT_TIMESTAMP()
  
  UNION ALL
  
  -- Ministry Teams
  SELECT 'ministry_teams', 'Kids Church', 1, TRUE, CURRENT_TIMESTAMP(), CURRENT_TIMESTAMP()
  UNION ALL
  SELECT 'ministry_teams', 'Multimedia', 2, TRUE, CURRENT_TIMESTAMP(), CURRENT_TIMESTAMP()
  UNION ALL
  SELECT 'ministry_teams', 'Prayer', 3, TRUE, CURRENT_TIMESTAMP(), CURRENT_TIMESTAMP()
  UNION ALL
  SELECT 'ministry_teams', 'Safety', 4, TRUE, CURRENT_TIMESTAMP(), CURRENT_TIMESTAMP()
  UNION ALL
  SELECT 'ministry_teams', 'Stage Mgmt', 5, TRUE, CURRENT_TIMESTAMP(), CURRENT_TIMESTAMP()
  UNION ALL
  SELECT 'ministry_teams', 'Technical', 6, TRUE, CURRENT_TIMESTAMP(), CURRENT_TIMESTAMP()
  UNION ALL
  SELECT 'ministry_teams', 'Ushering', 7, TRUE, CURRENT_TIMESTAMP(), CURRENT_TIMESTAMP()
  UNION ALL
  SELECT 'ministry_teams', 'Worship', 8, TRUE, CURRENT_TIMESTAMP(), CURRENT_TIMESTAMP()
)
ORDER BY category, display_order
